AI_SIGNAL_HUB_HOST=127.0.0.1
AI_SIGNAL_HUB_PORT=8000
AI_SIGNAL_HUB_DATA_DIR=./data
AI_SIGNAL_HUB_MAX_UPLOAD_BYTES=104857600
AI_SIGNAL_HUB_API_BASE_URL=http://127.0.0.1:8000
AI_SIGNAL_HUB_LEGACY_SAMPLE_PROJECT=../ai_signal_demo
AI_SIGNAL_HUB_LEGACY_REPORT_PROJECT=../报告信息抽取
# 报告默认纯大模型提取+全文复核；密钥配置到API进程环境，不提交真实密钥。
# DEEPSEEK_API_KEY=...（也兼容已有cc-api）
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
REPORT_LLM_THINKING=enabled
REPORT_LLM_REASONING_EFFORT=low
REPORT_LLM_MAX_OUTPUT_TOKENS=32768
REPORT_LLM_TIMEOUT_SECONDS=240
REPORT_LLM_MAX_REQUESTS=32
