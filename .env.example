AI_SIGNAL_HUB_HOST=127.0.0.1
AI_SIGNAL_HUB_PORT=8000
AI_SIGNAL_HUB_DATA_DIR=./data
AI_SIGNAL_HUB_MAX_UPLOAD_BYTES=104857600
AI_SIGNAL_HUB_API_BASE_URL=http://127.0.0.1:8000
# 组件源码已内置，通常无需覆盖以下路径。
AI_SIGNAL_HUB_SAMPLE_COMPONENT_DIR=./components/ai_signal_demo
AI_SIGNAL_HUB_REPORT_COMPONENT_DIR=./components/report_extractor
AI_SIGNAL_HUB_SEED_DATA_DIR=./components/seed_data
# 报告默认纯大模型提取+全文复核；密钥配置到API进程环境，不提交真实密钥。
# DEEPSEEK_API_KEY=...（也兼容已有cc-api）
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
REPORT_LLM_THINKING=enabled
REPORT_LLM_REASONING_EFFORT=low
REPORT_LLM_MAX_OUTPUT_TOKENS=32768
REPORT_LLM_TIMEOUT_SECONDS=240
REPORT_LLM_MAX_REQUESTS=32

# 显式允许远端时，样本侧复用报告抽取的 DeepSeek V4 配置和系统变量 cc-api。
# 以下三项只有在需要覆盖共同配置时才设置；仅配置密钥不会授权样本外发。
SAMPLE_LLM_ENABLED=true
# SAMPLE_LLM_BASE_URL=https://api.deepseek.com
# SAMPLE_LLM_MODEL=deepseek-v4-flash
# SAMPLE_LLM_API_KEY=...（默认依次读取DEEPSEEK_API_KEY、cc-api）
# 默认禁止样本材料外发。远端模型必须同时显式开启并选择外发策略。
SAMPLE_LLM_ALLOW_REMOTE=false
SAMPLE_LLM_TRANSFER_POLICY=local_only
SAMPLE_LLM_MODE=coverage
# 这是异常保护的请求次数上限，不是总token预算。
SAMPLE_LLM_MAX_REQUESTS=128
SAMPLE_LLM_MAX_REASONING_ROUNDS=4
SAMPLE_LLM_MAX_QUERIES_PER_ROUND=8
SAMPLE_LLM_MAX_CONTEXT_UNITS=32
SAMPLE_LLM_TIMEOUT_SECONDS=240
SAMPLE_LLM_MAX_INPUT_TOKENS=64000
SAMPLE_LLM_MAX_OUTPUT_TOKENS=16384

# Docker静态恢复工具；镜像由scripts/build_static_tool_images.ps1构建。
STATIC_TOOLS_DOCKER_ENABLED=true
JADX_DOCKER_IMAGE=ai-signal/jadx:1.5.6
GHIDRA_DOCKER_IMAGE=ai-signal/ghidra:12.1.3
STATIC_TOOL_TIMEOUT_SECONDS=600
